<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Title & Unread Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔔 NOTIFICATION CENTER"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUnreadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 Unread"
            android:textColor="#10b981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card_selected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FCM TOPIC SUBSCRIPTIONS"
        android:textColor="#64748b"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- FCM Topics Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTopicGauteng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="✓ topics/gauteng"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:background="@drawable/bg_card_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />

            <TextView
                android:id="@+id/chipTopicN1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="✓ topics/corridor_n1"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:background="@drawable/bg_card_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />

            <TextView
                android:id="@+id/chipTopicWC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="topics/western_cape"
                android:textColor="#cbd5e1"
                android:textSize="11sp"
                android:background="@drawable/bg_rounded_slate"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />

            <TextView
                android:id="@+id/chipTopicKZN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="topics/kwazulu_natal"
                android:textColor="#cbd5e1"
                android:textSize="11sp"
                android:background="@drawable/bg_rounded_slate"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Notification List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
