<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- Emerald Ambient Glow -->
    <View
        android:id="@+id/glowView"
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:background="@drawable/bg_emerald_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Modal Card Container -->
    <LinearLayout
        android:id="@+id/authCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_unselected"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="450dp">

        <!-- Top App Icon & Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_rounded_slate"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="#94a3b8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_squircle_emerald">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:rotation="45"
                        android:src="@drawable/ic_navigation"
                        app:tint="#ffffff" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/auth_tagline"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Segmented Tab Switcher -->
        <LinearLayout
            android:id="@+id/tabSwitcher"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_tab_switcher"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tabSignIn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_item_selected"
                android:gravity="center"
                android:text="Sign In"
                android:textColor="#020617"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabCreateAccount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Create Account"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Google Sign-In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:text="Sign in with Google"
            android:textColor="#1e293b"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_google_logo"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@null"
            app:backgroundTint="#ffffff"
            app:cornerRadius="16dp"
            app:elevation="4dp" />

        <!-- Divider: OR CONTINUE WITH EMAIL -->
        <LinearLayout
            android:id="@+id/layoutSocialDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#334155" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR CONTINUE WITH EMAIL"
                android:textColor="#64748b"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginHorizontal="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#334155" />
        </LinearLayout>

        <!-- Success State (Hidden by default) -->
        <LinearLayout
            android:id="@+id/successSplash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_check"
                app:tint="#00d084" />

            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, Sipho!"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_selected"
                android:drawableStart="@drawable/ic_sparkles"
                android:drawablePadding="6dp"
                android:drawableTint="#00d084"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/impact_points_credited"
                android:textColor="#00d084"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/entering_routewise"
                android:textColor="#64748b"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Auth Form -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="330dp"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Full Name (Register Only) -->
                <LinearLayout
                    android:id="@+id/groupFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="FULL NAME"
                        android:textColor="#94a3b8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_slate"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="10dp"
                        android:drawableTint="#94a3b8"
                        android:hint="Sipho Dlamini"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:textColor="#ffffff"
                        android:textColorHint="#64748b"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Phone Number (Register Only) -->
                <LinearLayout
                    android:id="@+id/groupPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="PHONE NUMBER"
                        android:textColor="#94a3b8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_slate"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawablePadding="10dp"
                        android:drawableTint="#94a3b8"
                        android:hint="+27 82 456 7890"
                        android:inputType="phone"
                        android:paddingHorizontal="14dp"
                        android:textColor="#ffffff"
                        android:textColorHint="#64748b"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Province & City (Register Only) -->
                <LinearLayout
                    android:id="@+id/groupLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="PROVINCE"
                            android:textColor="#94a3b8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            app:boxBackgroundColor="#131d2e"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false">

                            <AutoCompleteTextView
                                android:id="@+id/spinnerProvince"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:inputType="none"
                                android:padding="0dp"
                                android:text="Gauteng"
                                android:textColor="#ffffff"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="CITY"
                            android:textColor="#94a3b8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            app:boxBackgroundColor="#131d2e"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false">

                            <AutoCompleteTextView
                                android:id="@+id/spinnerCity"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:inputType="none"
                                android:padding="0dp"
                                android:text="Johannesburg"
                                android:textColor="#ffffff"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Email Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="EMAIL ADDRESS"
                        android:textColor="#94a3b8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_slate"
                        android:drawableStart="@drawable/ic_mail"
                        android:drawablePadding="10dp"
                        android:drawableTint="#94a3b8"
                        android:hint="sipho.dlamini@routewise.co.za"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="14dp"
                        android:textColor="#ffffff"
                        android:textColorHint="#64748b"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PASSWORD"
                            android:textColor="#94a3b8"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnForgotPasswordLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Forgot Password?"
                            android:textColor="#10b981"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_slate"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="10dp"
                        android:drawableTint="#94a3b8"
                        android:hint="••••••••••••"
                        android:inputType="textPassword"
                        android:paddingHorizontal="14dp"
                        android:textColor="#ffffff"
                        android:textColorHint="#64748b"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Forgot Password Modal Scroll View -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollResetPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="380dp"
            android:visibility="gone"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
            android:scrollbars="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForgotPasswordModal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#0f172a"
                app:strokeColor="#10b981"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔑 Reset Password"
                            android:textColor="#10b981"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseForgotModal"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_slate"
                            android:src="@drawable/ic_close"
                            app:tint="#f43f5e"
                            android:contentDescription="Close Reset Modal" />
                    </LinearLayout>

                    <!-- Step 1: Email Input -->
                    <LinearLayout
                        android:id="@+id/layoutResetStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENTER REGISTERED EMAIL ADDRESS"
                            android:textColor="#94a3b8"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etResetEmail"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_rounded_slate"
                            android:hint="sipho.dlamini@routewise.co.za"
                            android:textColorHint="#64748b"
                            android:textColor="#ffffff"
                            android:textSize="13sp"
                            android:paddingHorizontal="12dp"
                            android:inputType="textEmailAddress"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendResetCode"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:text="Send 6-Digit Verification Code"
                            android:textColor="#020617"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#10b981"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <!-- Step 2: Code & New Password -->
                    <LinearLayout
                        android:id="@+id/layoutResetStep2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvAutoFillCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔑 Verification Code: 849201 — Tap to Auto-Fill"
                            android:textColor="#38bdf8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_rounded_slate"
                            android:padding="8dp"
                            android:layout_marginBottom="10dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6-DIGIT VERIFICATION CODE"
                            android:textColor="#94a3b8"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etVerificationCode"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_rounded_slate"
                            android:hint="849201"
                            android:textColorHint="#64748b"
                            android:textColor="#ffffff"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:letterSpacing="0.2"
                            android:inputType="number"
                            android:maxLength="6"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEW PASSWORD"
                            android:textColor="#94a3b8"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_rounded_slate"
                            android:hint="Enter new password"
                            android:textColorHint="#64748b"
                            android:textColor="#ffffff"
                            android:textSize="13sp"
                            android:paddingHorizontal="12dp"
                            android:inputType="textPassword"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/tvPasswordMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Passwords match"
                            android:textColor="#10b981"
                            android:textSize="10sp"
                            android:visibility="gone"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdatePassword"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:text="Update Password &amp; Sign In"
                            android:textColor="#020617"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#10b981"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitAuth"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_emerald"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawableTint="#020617"
            android:paddingHorizontal="24dp"
            android:text="Sign In to RouteWise"
            android:textColor="#020617"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
